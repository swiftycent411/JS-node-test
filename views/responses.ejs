<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Survey Responses</title>
    <link rel="stylesheet" href="/styles.css">
</head>
<body>
    <h1>Survey Responses</h1>
    
    <table border="1">
        <thead>
            <tr>
                <th>Survey ID</th>
                <th>Respondent ID</th>
                <th>Completed Date</th>
                <th>Contact Name</th>
                <th>Email</th>
                <th>Response Memo</th>
            </tr>
        </thead>
        <tbody>
            <% Object.keys(groupedResponses).forEach(respondentId => { 
                const response = groupedResponses[respondentId]; %>
                <tr>
                    <td><%= response.SurveyId %></td>
                    <td><%= respondentId %></td>
                    <td><%= response.CompletedDate || "N/A" %></td>
                    <td><%= response.ContactName || "N/A" %></td>
                    <td><%= response.Email || "N/A" %></td>
                    <td><%= response.ResponseMemo || "N/A" %></td>
                </tr>
            <% }); %>
        </tbody>
    </table>
</body>
</html>
